# Machine/user paths, individual-level outputs and run logs stay in backup.
/reports/**/environment.json
/reports/**/*.jsonl
/reports/**/*.log
/reports/hardware.json
/reports/runtime.json
/reports/mapa_repositorio.md
# Unreviewed JSON outputs can contain record-level details. Already tracked,
# explicitly audited manifests/configs/aggregates remain tracked unchanged.
/reports/**/*.json
# Credentials must never be picked up by routine staging.
.env
.env.*
!.env.example
*.pem
*.key
