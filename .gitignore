# Local-only research assets; ignoring is not permission to delete.
/data/
/.venv*/
*.joblib
*.npy
*.zip
/reports/**/models/
/reports/**/*.csv
/reports/**/sources/
/artigo/figuras/*.png
/artigo/figuras/*.pdf
